#--------------------------------------------------------------------
# SyncCRM environment. Copy to .env and fill in. Never commit .env.
#--------------------------------------------------------------------
CI_ENVIRONMENT = production

# Public address of the app, with a trailing slash. Used for invite links and assets.
app.baseURL = 'https://crm.example.com/'

# Where uploaded files are stored. Keep this OUTSIDE the web root.
app.uploadDir = '/home/master/applications/xxxxxx/private_html/uploads'

# One-time web installer at /install?key=... Blank disables it. Clear after go-live.
app.installKey = ''

app.timezone = 'Asia/Kolkata'

# MySQL (Cloudways: Application > Access Details > MySQL Access)
database.default.hostname = localhost
database.default.database = synccrm
database.default.username = synccrm
database.default.password = secret
database.default.port = 3306
