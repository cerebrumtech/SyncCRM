#--------------------------------------------------------------------
# SyncCRM environment (copy to .env). Never commit .env.
#--------------------------------------------------------------------
CI_ENVIRONMENT = production

# Public address of the app, with trailing slash (used for invite links).
app.baseURL = 'https://crm.example.com/'

# MySQL / MariaDB (Cloudways: Application > Access Details > MySQL Access)
database.default.hostname = localhost
database.default.database = synccrm
database.default.username = synccrm
database.default.password = secret
database.default.DBDriver = MySQLi
database.default.port = 3306

# Where uploaded files are stored (outside the web root). Default: writable/uploads
# app.uploadDir = /home/master/applications/xxxx/private_html/uploads

# One-time web installer (/install?key=...). Remove or blank after go-live.
app.installKey = ''

# Encryption key for sessions/cookies. Generate with: php spark key:generate
encryption.key = 
